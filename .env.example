NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quan_ly_rau_cai?schema=public

# PostgreSQL — chỉ dùng để khởi tạo container postgres qua docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quan_ly_rau_cai

# Redis (ioredis, bắt buộc — RedisModule/RedisService)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
